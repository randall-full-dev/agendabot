# Copia este archivo como .env y llena los valores.
# El .env NUNCA se sube al repo (ya está en .gitignore).
#
# Solo necesitas la sección de la fase en la que estés trabajando.


# =============================================================
#  Fase 1 — Extracción con IA
# =============================================================

# Llave de la API de Anthropic.
# Dónde: platform.claude.com > API Keys > Create Key
# Formato: sk-ant-api03-... (se muestra una sola vez al crearla)
# REQUERIDA. Sin esto el extractor no arranca.
ANTHROPIC_API_KEY=

# Modelo que hace la extracción.
# Medido contra los 15 casos de test/casos.js (una corrida cada uno):
#   claude-sonnet-5   15/15, ~1.00¢ por mensaje  <- el default
#   claude-opus-5     15/15, ~1.60¢ por mensaje  <- plan B si sonnet falla en uso real
#   claude-haiku-4-5  13/15, ~0.58¢ por mensaje  <- erró un día de la semana.
#                     Usa ANTHROPIC_THINKING_BUDGET, NO ANTHROPIC_EFFORT (ver abajo).
# Opcional. Por defecto: claude-sonnet-5
ANTHROPIC_MODEL=

# ---- Cuánto razona el modelo: dos perillas, una por generación ----
# Son la misma idea con distinto nombre. Cada modelo acepta una y rechaza la otra.
# Usa ANTHROPIC_EFFORT con opus-5 y sonnet-5.
# Usa ANTHROPIC_THINKING_BUDGET con haiku-4-5.
# Si pones el presupuesto, el esfuerzo se omite solo (no hay que borrarlo).

# Nivel de razonamiento. Más = más preciso, más lento y más caro.
# Valores: low | medium | high | xhigh | max | ninguno
#   ninguno   omite el parámetro por completo
# Solo en: claude-sonnet-5, claude-opus-5.
#          claude-haiku-4-5 devuelve error 400 si lo recibe.
# Opcional. Por defecto: medium (con el que los 15 casos pasan)
ANTHROPIC_EFFORT=

# Presupuesto de razonamiento, en tokens.
# Valores: un entero entre 1024 y 15999. Referencias: 2000 poco, 4000 medio,
#          8000 bastante. Vacío = el modelo responde sin razonar antes.
# Solo en: claude-haiku-4-5.
#          sonnet-5 y opus-5 devuelven error 400 si lo reciben.
# Opcional. Por defecto: vacío
ANTHROPIC_THINKING_BUDGET=


# =============================================================
#  Fase 2 — Calendario (iCloud vía CalDAV)
# =============================================================

# El correo de tu Apple ID.
# Formato: correo@ejemplo.com
# Requerida a partir de la Fase 2.
APPLE_ID=

# Contraseña específica de app. NO es la contraseña de tu Apple ID.
# Dónde: appleid.apple.com > Iniciar sesión y seguridad >
#        Contraseñas específicas de app (requiere 2FA activo en la cuenta)
# Formato: xxxx-xxxx-xxxx-xxxx (16 letras en 4 grupos)
# Requerida a partir de la Fase 2. Se puede revocar sin tocar la cuenta.
APPLE_APP_PASSWORD=

# En qué calendario de iCloud se crean los eventos.
# Valores: el nombre tal como aparece en la app Calendario del iPhone
#          (ejemplos: Trabajo, Personal, Obra)
# Opcional. Vacío = el calendario por defecto de la cuenta.
ICLOUD_CALENDAR_NAME=


# =============================================================
#  Fase 3 — WhatsApp
# =============================================================
# Estas dos son para Meta Cloud API. Si al final se usa Baileys,
# no aplican y se cambian por otra cosa.

# Token de acceso de la app de WhatsApp.
# Dónde: developers.facebook.com > tu app > WhatsApp > Configuración de la API
# Formato: cadena larga que empieza con EAA...
# Requerida a partir de la Fase 3.
WHATSAPP_TOKEN=

# ID del número de teléfono desde el que responde el bot.
# Dónde: mismo panel, campo "Identificador de número de teléfono"
# Formato: solo dígitos (ejemplo: 123456789012345)
#          OJO: no es el número telefónico, es un ID interno de Meta.
# Requerida a partir de la Fase 3.
WHATSAPP_PHONE_ID=

# Token que TÚ inventas para el apretón de manos del webhook. Se lo das a Meta
# al registrar la URL y el servidor verifica que lo que llega coincida.
# Dónde: lo escribes igual aquí y en el panel de Meta al configurar el webhook.
# Formato: cualquier cadena larga y difícil de adivinar.
# Requerida a partir de la Fase 3.
WHATSAPP_VERIFY_TOKEN=

# Llave con la que Meta firma cada webhook (HMAC-SHA256). Con ella el servidor
# descarta cualquier POST que no venga de Meta.
# Dónde: developers.facebook.com > tu app > Configuración de la app > Básica >
#        Clave secreta de la app
# Opcional pero muy recomendada. Vacía = se acepta cualquier POST (solo para
# pruebas locales).
WHATSAPP_APP_SECRET=

# Números que pueden usar el bot (wa_id: código de país + número, sin el +).
# Valores: uno o varios separados por coma (ejemplo: 5215512345678)
# Opcional pero recomendada. Vacía = cualquiera que escriba al número del bot.
WHATSAPP_ALLOWED_NUMBERS=


# =============================================================
#  General
# =============================================================

# Zona horaria con la que se interpretan "mañana", "el próximo martes", etc.
# Valores: cualquier zona IANA
#          (México: America/Mexico_City | America/Tijuana | America/Cancun)
# Opcional. Por defecto: America/Mexico_City
TZ=America/Mexico_City

# Puerto en el que escucha el servidor (Fase 3).
# Valores: cualquier puerto libre. En Railway/Render lo inyecta la plataforma
#          y no hay que ponerlo.
# Trampa: el 3000 (el default) lo usan los repos de control-de-obra en la laptop
#         de desarrollo; ahí va 3100 para que no se peleen el puerto. Si se cambia,
#         hay que reapuntar el Tailscale Funnel: tailscale funnel --bg <puerto>.
# Opcional. Por defecto: 3000
PORT=3100
